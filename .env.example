# Copy to .env (local) or set as secrets (HF Space / Docker). Never commit .env!
# Everything is optional - the Guardian only starts services whose config exists.

# --- Database (asyncpg / PostgreSQL). Leave unset for database-free mode ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Encryption (both needed) ---
# MASTER_ENCRYPTION_KEY=
# PERSISTENT_ENCRYPTION_SALT=

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_TMP=false
ENABLE_PUBLIC_LOGS=true
PYFUNDAMENTS_DEBUG=false
# APP_ENV=production
